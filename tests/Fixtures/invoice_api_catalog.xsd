    <xs:import namespace="http://schemas.nav.gov.hu/NTCA/1.0/common" schemaLocation="../../lib/Resources/XSD/common.xsd"/>
    <xs:import namespace="http://schemas.nav.gov.hu/OSA/3.0/base" schemaLocation="../../lib/Resources/XSD/v3/invoiceBase.xsd"/>
    <xs:import namespace="http://schemas.nav.gov.hu/OSA/3.0/api" schemaLocation="../../lib/Resources/XSD/v3/invoiceApi.xsd"/>
</xs:schema>
